{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "binaryDir": "${sourceDir}/../build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "LLVM_TARGETS_TO_BUILD": "X86;Sparc",
                "LLVM_EXPERIMENTAL_TARGETS_TO_BUILD": "LEG;Cucaracha",
                "LLVM_ENABLE_PROJECTS": "clang;clang-tools-extra",
                "LLVM_INCLUDE_TESTS": true,
                "CUCARACHA_GENERATE_TD": true
            }
        },
        {
            "name": "MinGW",
            "inherits": "base",
            "binaryDir": "${sourceDir}/../build_mingw",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "LLVM_HOST_TRIPLE": "x86_64"
            },
            "generator": "MinGW Makefiles"
        },
        {
            "name": "Visual Studio 2022",
            "inherits": "base",
            "binaryDir": "${sourceDir}/../build_vs2022",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "LLVM_HOST_TRIPLE": "x86_64"
            },
            "generator": "Visual Studio 17 2022"
        },
        {
            "name": "Linux GCC Docker",
            "inherits": "base",
            "binaryDir": "${sourceDir}/../build_docker_linux_gcc",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "LLVM_HOST_TRIPLE": "x86_64-linux-gnu"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "Linux GCC",
            "inherits": "base",
            "binaryDir": "${sourceDir}/../build_linux_gcc",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "LLVM_HOST_TRIPLE": "x86_64-linux-gnu"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "MinGW",
            "configurePreset": "MinGW",
            "jobs": 6
        },
        {
            "name": "MinGW verbose makefile",
            "inherits": "MinGW",
            "verbose": true,
            "jobs": 10
        },
        {
            "name": "Visual Studio 2022",
            "configurePreset": "Visual Studio 2022",
            "jobs": 12
        },
        {
            "name": "Linux GCC",
            "configurePreset": "Linux GCC",
            "jobs": 10
        }
    ]
}