	.type	main,@function
main:                                   # @main
# %bb.0:
	MOVIMM16L #4, r4
	SUB sp, r4, sp
	ST lr, sp
	MOVIMM16L #0, r0
	LD sp, lr
	MOVIMM16L #4, r4
	ADD sp, r4, sp
	JMP lr, lr
.Lfunc_end0:
	.size	main, .Lfunc_end0-main
                                        # -- End function
