{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) debug clang",
            "type": "cppdbg",
            "preLaunchTask": "CMake: build clang",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/bin/clang",
            "args": [
                "-mllvm",
                "-debug",
                "--target=leg",
                "-ffreestanding",
                "-S",
                "-O3",
                "-Ileg_examples",
                "leg_examples/main.cpp",
                "-o",
                "leg_examples/main.s"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "$PATH:${command:cmake.buildDirectory}/bin"
                }
            ],
            "MIMode": "gdb",
        },
        {
            "name": "(gdb) Launch Debug Target",
            "type": "cppdbg",
            "request": "launch",
            // Resolved by CMake Tools:
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    // add the directory where our target was built to the PATHs
                    // it gets resolved by CMake Tools:
                    "name": "PATH",
                    "value": "${env:PATH}:${command:cmake.getLaunchTargetDirectory}"
                },
                {
                    "name": "OTHER_VALUE",
                    "value": "Something something"
                }
            ],
            "externalConsole": true,
            "MIMode": "gdb",
        },
    ]
}